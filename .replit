modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "openssl"]

[[ports]]
localPort = 8501
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-lc", "python -m streamlit run app/Home.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true"]
