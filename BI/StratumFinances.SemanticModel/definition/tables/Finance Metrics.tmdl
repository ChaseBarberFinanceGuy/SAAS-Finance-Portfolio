	measure 'NRR YoY Display' =
			
			VAR Change = [NRR YoY Change Ppts]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Change), BLANK(),
			    Change > 0, "▲ " & FORMAT(Change, "0.0") & " ppts",
			    Change < 0, "▼ " & FORMAT(ABS(Change), "0.0") & " ppts",
			    "— 0.0 ppts"
			)
		displayFolder: 08 Card INCR/DECR
		lineageTag: 0a3423a3-fb2d-403f-b2cd-7861222652ce

