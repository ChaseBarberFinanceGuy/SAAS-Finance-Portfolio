	measure 'Average ARR per Active Account Prior Year' =
			
			VAR AsOfDate =
			    MAX('Calendar'[Date])
			VAR AsOfMonth =
			    DATE(YEAR(AsOfDate), MONTH(AsOfDate), 1)
			VAR PriorYearMonth =
			    EDATE(AsOfMonth, -12)
			RETURN
			    CALCULATE(
			        [Average ARR per Active Account],
			        REMOVEFILTERS('Calendar'),
			        'Calendar'[Date] = PriorYearMonth
			    )
		displayFolder: 08 Card INCR/DECR
		lineageTag: dab5df4f-3f6d-4a14-8512-6ac9226e4eb0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average ARR per Active Account Growth YoY' =
			
			VAR CurrentValue = [Average ARR per Active Account]
			VAR PriorValue = [Average ARR per Active Account Prior Year]
			RETURN
			    IF(
			        ISBLANK(PriorValue),
			        BLANK(),
			        DIVIDE(CurrentValue - PriorValue, PriorValue)
			    )
		displayFolder: 08 Card INCR/DECR
		lineageTag: 7a14eb99-24c9-46ef-8d8c-c7bfd7315727

		annotation PBI_FormatHint = {"isGeneralNumber":true}

