			    Change < 0, "▼ " & FORMAT(ABS(Change), "0.0%"),
			    "— 0.0%"
			)
		displayFolder: 08 Card INCR/DECR
		lineageTag: ae8f3e10-6386-4a70-8570-2c46a97946fb

	measure 'Active Customer Growth YoY Color' =
			
