	measure 'Active Customer Growth YoY' =
			
			VAR CurrentCustomers = [Active Customers]
			VAR PriorCustomers = [Active Customers Prior Year]
			RETURN
			    IF(
			        ISBLANK(PriorCustomers),
			        BLANK(),
			        DIVIDE(
			            CurrentCustomers - PriorCustomers,
			            PriorCustomers
			        )
			    )
		formatString: 0
		displayFolder: 02 Growth
		lineageTag: 03d536d1-07da-4ea5-90ac-cb140aaa5a03

	measure 'Active Customers Prior Year' =
			
			VAR AsOfDate =
			    MAX('Calendar'[Date])
			VAR AsOfMonth =
			    DATE(YEAR(AsOfDate), MONTH(AsOfDate), 1)
			VAR PriorYearMonth =
			    EDATE(AsOfMonth, -12)
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('subscription months'[customer id]),
			        REMOVEFILTERS('Calendar'),
			        'subscription months'[month start date] = PriorYearMonth,
			        'subscription months'[mrr usd] > 0
			    )
		formatString: 0
		displayFolder: 02 Growth
		lineageTag: 3e5a934e-dca2-46a2-9112-c0168654c09a

	measure 'Active Customer Growth YoY Display' =
			
			VAR Change = [Active Customer Growth YoY]
			RETURN
			SWITCH(
